# Humanity Union — root environment example
# Copy to .env for Docker Compose staging/production-like deployment.
# Never commit real secrets.
# See: project/architecture/operations/PRODUCTION_CONFIGURATION_OPERATIONS_v1.0.md

NODE_ENV=production

# ---------------------------------------------------------------------------
# API runtime
# ---------------------------------------------------------------------------
PORT=4000
API_PORT=4000
PLATFORM_VERSION=0.1.0
PLATFORM_MODE=beta
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# MongoDB (dedicated staging/production DB — never humanity_union_dev in prod)
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=humanity_union_staging

# ---------------------------------------------------------------------------
# Auth (HttpOnly cookies; Secure when NODE_ENV=production)
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
# PWA remembered sessions — keep aligned with apps/api/.env.example (30d)
JWT_REFRESH_EXPIRES_IN=30d
AUTH_BOOTSTRAP_FALLBACK=false
AUTH_REQUIRE_EMAIL_VERIFICATION=false
ALLOW_PUBLIC_REGISTRATION=false
BETA_INVITE_EXPIRES_DAYS=14
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20

# ---------------------------------------------------------------------------
# CORS / public URLs (exact origins; never *)
# Split topology example: Web https://staging.huws.org + API https://api-staging.huws.org
# Same-origin nginx alternative: both WEB/CORS and NEXT_PUBLIC_API_BASE_URL use the site origin
# ---------------------------------------------------------------------------
CORS_ORIGIN=https://staging.example.org
WEB_ORIGIN=https://staging.example.org
# API origin only — client paths already include /api/v1/... (do NOT append /api)
API_PUBLIC_URL=https://api-staging.example.org

# ---------------------------------------------------------------------------
# Durable persistence (production/staging — do not use file/.runtime defaults)
# ---------------------------------------------------------------------------
NOTIFICATION_PERSISTENCE=mongodb
REMINDER_PERSISTENCE=mongodb
PUBLIC_NEWS_PERSISTENCE=mongodb
INITIATIVE_COLLECTIVE_DECISION_LIFECYCLE_DRAFT_PERSISTENCE=mongodb
INITIATIVE_IMPLEMENTATION_COMMITMENT_LIFECYCLE_DRAFT_PERSISTENCE=mongodb
INITIATIVE_IMPLEMENTATION_TRACKING_LIFECYCLE_DRAFT_PERSISTENCE=mongodb
INITIATIVE_OFFICIAL_RESPONSE_LIFECYCLE_DRAFT_PERSISTENCE=mongodb
INITIATIVE_PUBLIC_IMPACT_LIFECYCLE_DRAFT_PERSISTENCE=mongodb
INITIATIVE_CIVIC_ARCHIVE_LIFECYCLE_DRAFT_PERSISTENCE=mongodb

# ---------------------------------------------------------------------------
# Email (transactional — Flockmail canonical host)
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=mock
SMTP_HOST=smtp-out.flockmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.org
SMTP_FROM_NAME=Humanity Union
EMAIL_REPLY_TO=
EMAIL_LOGO_URL=https://huws.org/brand/humanity-union-logo-white-email.png
EMAIL_SEND_LOGIN_NOTIFICATIONS=false
ALLOW_REAL_EMAIL_IN_TESTS=false
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# AI / Translation (server-side only)
# ---------------------------------------------------------------------------
LIFECYCLE_AI_PROVIDER=deterministic
GEMINI_API_KEY=
LIFECYCLE_AI_GEMINI_MODEL=gemini-flash-lite-latest
TRANSLATION_PROVIDER=deterministic
WORKSPACE_ASSISTANT_PROVIDER=mock
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Outbox
# ---------------------------------------------------------------------------
OUTBOX_DISPATCH_ENABLED=true
OUTBOX_DISPATCH_INTERVAL_MS=2000
OUTBOX_DISPATCH_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# Web (build-time for Next.js)
# NEXT_PUBLIC_API_BASE_URL must be the API origin WITHOUT a trailing /api path
# Production: https://api.huws.org + https://huws.org
# Staging:    https://api-staging.huws.org + https://staging.huws.org
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=https://api-staging.huws.org
NEXT_PUBLIC_SITE_URL=https://staging.huws.org
NEXT_PUBLIC_PLATFORM_MODE=staging
NEXT_PUBLIC_ALLOW_BOOTSTRAP_UI=false
NEXT_PUBLIC_MEMBERSHIP_SUCCESS_PREVIEW=false
# Server-side public projection source for Next (prefer api for live data)
PUBLIC_PROJECTION_PROVIDER=api

# ---------------------------------------------------------------------------
# Reverse proxy
# ---------------------------------------------------------------------------
NGINX_HTTP_PORT=80
