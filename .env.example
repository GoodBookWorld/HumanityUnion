# Humanity Union — root environment example
# Copy to .env for Docker Compose staging/production deployment.
# Never commit real secrets.

NODE_ENV=production

# API
PORT=4000
API_PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=humanity_union
JWT_ACCESS_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
# Alternative: JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_EXPIRES_IN=7d
AUTH_BOOTSTRAP_FALLBACK=false
AUTH_REQUIRE_EMAIL_VERIFICATION=false
PLATFORM_MODE=beta
ALLOW_PUBLIC_REGISTRATION=false
BETA_INVITE_EXPIRES_DAYS=14
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
CORS_ORIGIN=https://staging.example.org
WEB_ORIGIN=https://staging.example.org
API_PUBLIC_URL=https://staging.example.org/api
NOTIFICATION_PERSISTENCE=mongodb

# Email infrastructure (transactional only)
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@humanityunion.local
SMTP_SECURE=false
RESEND_API_KEY=
EMAIL_FROM_NAME=Humanity Union
EMAIL_REPLY_TO=
EMAIL_SEND_LOGIN_NOTIFICATIONS=false

# Web (build-time for Next.js)
NEXT_PUBLIC_API_BASE_URL=https://staging.example.org/api
NEXT_PUBLIC_SITE_URL=https://staging.example.org

# Reverse proxy
NGINX_HTTP_PORT=80

# Workspace Assistant (optional — mock is default for staging)
WORKSPACE_ASSISTANT_PROVIDER=mock
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000
AI_MAX_TOKENS=800

# Platform metadata
PLATFORM_VERSION=0.1.0
