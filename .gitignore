# Narrow exceptions: Web geography facades/helpers under apps/web/src/data/geography.
# Do not broaden this to unrelated data/ trees. Canonical datasets live in packages/geography.
!apps/web/src/data/
!apps/web/src/data/geography/
!apps/web/src/data/geography/**

# Pack 10B — static City/Community JSON served at /data/geography/communities/*
# (required at runtime by fetchCommunitiesByRegion; must ship with the Web artifact).
!apps/web/public/data/
!apps/web/public/data/geography/
!apps/web/public/data/geography/**

# Upstream geography source dump (local normalize input; keep LICENSE/README tracked)
packages/geography/source/countries+states+cities.json
packages/geography/source/regions.json
packages/geography/source/subregions.json

.DS_Store
