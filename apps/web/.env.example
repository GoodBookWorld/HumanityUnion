# Humanity Union Web — environment example
# Copy to apps/web/.env.local for local development.
# Never commit real secrets.

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PLATFORM_MODE=development
NEXT_PUBLIC_ALLOW_BOOTSTRAP_UI=false
NEXT_PUBLIC_MEMBERSHIP_SUCCESS_PREVIEW=false

# Optional — Stripe publishable key (Checkout uses server redirect; not required for TASK-092 flow)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
