# Humanity Union Web — environment example
# Copy to apps/web/.env.local for local development.
# Never commit real secrets.
# See: project/architecture/operations/PRODUCTION_CONFIGURATION_OPERATIONS_v1.0.md

# API origin ONLY. Client request paths already start with /api/v1/...
# Local:   http://localhost:4000
# Staging: https://api-staging.huws.org
# Prod:    https://api.huws.org
# Do NOT set this to https://host/api (avoids /api/api/v1 double prefix).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Public site origin (documentation / consistency; limited runtime use)
# Staging: https://staging.huws.org
# Prod:    https://huws.org
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Platform mode — staging/development => robots noindex,nofollow
# production | staging | development | beta
NEXT_PUBLIC_PLATFORM_MODE=development
# Optional: ENABLE_HSTS=true only when HTTPS termination is understood

# Must remain false outside controlled bootstrap scenarios
NEXT_PUBLIC_ALLOW_BOOTSTRAP_UI=false
NEXT_PUBLIC_MEMBERSHIP_SUCCESS_PREVIEW=false

# Optional — Stripe publishable key (Checkout often uses server redirect)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Server-side Next public projection source: bootstrap | api
# Prefer api for staging/production live data.
PUBLIC_PROJECTION_PROVIDER=bootstrap
