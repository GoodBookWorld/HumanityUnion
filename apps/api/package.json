{
  "name": "@hu/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:prod": "node dist/index.js",
    "start:src": "tsx src/index.ts",
    "test": "tsx ./scripts/run-tests-recursively.ts",
    "test:smtp": "tsx scripts/test-smtp.ts",
    "dev:reset-auth-rate-limits": "tsx src/scripts/dev-reset-auth-rate-limits.ts",
    "provision:staging-admin": "tsx src/scripts/provision-staging-admin.ts",
    "migrate:staging-historical-data": "tsx src/scripts/migrate-staging-historical-data.ts",
    "migrate:staging-historical-media": "tsx src/scripts/migrate-staging-historical-media.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "@hu/geography": "workspace:*",
    "@hu/media-registry": "workspace:*",
    "@hu/types": "workspace:*",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.20.0",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "stripe": "^18.5.0",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "typescript": "^6.0.3"
  }
}
