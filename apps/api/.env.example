# Humanity Union API — environment example
# Copy to apps/api/.env for local development.
# Never commit real secrets.

NODE_ENV=development
PORT=4000
API_PORT=4000

# MongoDB Atlas (external) or local Mongo
MONGODB_URI=mongodb://localhost:27017/humanity_union_dev
MONGODB_DATABASE=humanity_union_dev

# Authentication
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
# JWT access token lifetime (default 15 minutes)
JWT_ACCESS_EXPIRES_IN=15m
# Alternative: JWT_ACCESS_TOKEN_TTL_MINUTES=15
# PWA Experience Pack 01 — rotating refresh lifetime (~30 days) for remembered
# installed-app sessions. Access JWT remains short-lived (~15m).
JWT_REFRESH_EXPIRES_IN=30d
# Launch Readiness Pack 07 — HttpOnly browser session cookie names (optional overrides)
# AUTH_ACCESS_COOKIE_NAME=hu_access_token
# AUTH_REFRESH_COOKIE_NAME=hu_refresh_token
# Cookies: HttpOnly, SameSite=Lax, Secure in production, Path=/, host-only (no Domain)
AUTH_BOOTSTRAP_FALLBACK=true
AUTH_REQUIRE_EMAIL_VERIFICATION=false
PLATFORM_MODE=development
ALLOW_PUBLIC_REGISTRATION=false
BETA_INVITE_EXPIRES_DAYS=14
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20

# Email infrastructure (transactional only — server-side; never expose to Web)
# Canonical outbound host: smtp-out.flockmail.com (Flockmail / Titan family)
EMAIL_PROVIDER=mock
SMTP_HOST=smtp-out.flockmail.com
SMTP_PORT=465
SMTP_SECURE=true
# Aliases: SMTP_USER / SMTP_USERNAME, SMTP_FROM_EMAIL / SMTP_FROM
SMTP_USER=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM=noreply@humanityunion.local
SMTP_FROM_NAME=Humanity Union
EMAIL_FROM_NAME=Humanity Union
EMAIL_REPLY_TO=
# Absolute public HTTPS logo (never localhost/relative — Gmail cannot fetch those)
EMAIL_LOGO_URL=https://huws.org/brand/humanity-union-logo-white-email.png
SMTP_CONNECTION_TIMEOUT_MS=15000
SMTP_GREETING_TIMEOUT_MS=15000
SMTP_SOCKET_TIMEOUT_MS=30000
SMTP_MAX_ATTEMPTS=3
RESEND_API_KEY=
SMTP_TEST_RECIPIENT=
HU_VERIFICATION_MODE=
# Manual smoke only — automated tests force mock even when SMTP_* is set
ALLOW_REAL_EMAIL_IN_TESTS=false
EMAIL_SEND_LOGIN_NOTIFICATIONS=false
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
EMAIL_CHANGE_TOKEN_TTL_MINUTES=60

# Registration email confirmation (6-digit code)
EMAIL_CONFIRMATION_CODE_TTL_MINUTES=15
EMAIL_CONFIRMATION_MAX_ATTEMPTS=5
EMAIL_CONFIRMATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_CONFIRMATION_MAX_SENDS_PER_HOUR=5
EMAIL_CONFIRMATION_PENDING_TOKEN_EXPIRES_IN=24h
# Development only: npm run migrate:email-confirmation-status
EMAIL_CONFIRMATION_MIGRATE_EXISTING=false

# Optional email two-step login (6-digit code at sign-in)
LOGIN_EMAIL_CODE_TTL_MINUTES=10
LOGIN_EMAIL_CODE_MAX_ATTEMPTS=5
LOGIN_EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60
LOGIN_EMAIL_TWO_STEP_CHALLENGE_TOKEN_EXPIRES_IN=15m

# CORS / public URLs
# Credentialed browser origins (comma-separated allowed). Never use `*`.
# Production: CORS_ORIGIN=https://huws.org WEB_ORIGIN=https://huws.org
# Staging:    CORS_ORIGIN=https://staging.huws.org WEB_ORIGIN=https://staging.huws.org
# API_PUBLIC_URL production: https://api.huws.org  (origin only — no trailing /api)
# API_PUBLIC_URL staging:    https://api-staging.huws.org
# Development: loopback http(s) origins on any port are also accepted by code.
CORS_ORIGIN=http://localhost:3000,http://localhost:3010
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# Auth rate limits (login/register defaults 20 / 15m; refresh is looser for multi-tab/PWA)
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
# AUTH_REFRESH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_REFRESH_RATE_LIMIT_MAX_ATTEMPTS=120

# Public media object storage (avatars / initiative / blog images)
# local = apps/api/.runtime/uploads (dev/tests; ephemeral on Render)
# r2 = Cloudflare R2 (S3-compatible) — preferred for staging/production
# memory = unit tests only
MEDIA_STORAGE_PROVIDER=local
# Production requires r2 OR explicit acceptance of ephemeral local disk:
# MEDIA_ALLOW_EPHEMERAL_LOCAL_STORAGE=true
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public media bucket (avatars / initiative / blog) — may bind a public custom domain
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# Private Shared Documents bucket — MUST differ from R2_BUCKET; no public domain
R2_PRIVATE_BUCKET=
# Optional override: local | r2 (defaults to MEDIA_STORAGE_PROVIDER)
# SECURE_DOCUMENT_STORAGE_PROVIDER=local

# Staging Web (build-time / Render Web env — never put secrets here):
# NEXT_PUBLIC_PLATFORM_MODE=staging
# NEXT_PUBLIC_API_BASE_URL=https://api-staging.huws.org
# NEXT_PUBLIC_SITE_URL=https://staging.huws.org
# API staging:
# PLATFORM_MODE=staging
# NODE_ENV=production
# CORS_ORIGIN=https://staging.huws.org
# WEB_ORIGIN=https://staging.huws.org
# API_PUBLIC_URL=https://api-staging.huws.org
# MONGODB_DATABASE=humanity_union_staging

# Workspace Assistant
WORKSPACE_ASSISTANT_PROVIDER=mock
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000
AI_MAX_TOKENS=800

# Lifecycle AI (Stage Intelligence assist — provider-independent)
# deterministic = offline suggestions (default/tests)
# gemini = GeminiLifecycleAiProvider (requires GEMINI_API_KEY)
LIFECYCLE_AI_PROVIDER=deterministic
GEMINI_API_KEY=
LIFECYCLE_AI_GEMINI_MODEL=gemini-flash-lite-latest
LIFECYCLE_AI_TIMEOUT_MS=25000
LIFECYCLE_AI_MAX_OUTPUT_TOKENS=2048
# Production Hardening Pack 01 (server-side only; never expose keys to Web)
LIFECYCLE_AI_DIAGNOSTICS=
LIFECYCLE_AI_MAX_RETRIES=2
LIFECYCLE_AI_MAX_PROMPT_CHARS=24000
LIFECYCLE_AI_MAX_HISTORY_TURNS=8
LIFECYCLE_AI_MAX_HISTORY_TURN_CHARS=800
LIFECYCLE_AI_MAX_DRAFT_EXCERPT_CHARS=4000
LIFECYCLE_AI_MAX_SOURCE_CONTEXT_CHARS=6000
LIFECYCLE_AI_MAX_REQUESTS_PER_MINUTE=10
LIFECYCLE_AI_MAX_REQUESTS_PER_DAY=200
LIFECYCLE_AI_DUPLICATE_WINDOW_MS=4000

# Language Architecture Pack 02 — TranslationProvider (server-side only)
# deterministic = offline/tests; gemini = GeminiTranslationProvider (reuses GEMINI_API_KEY)
TRANSLATION_PROVIDER=deterministic
TRANSLATION_GEMINI_MODEL=
TRANSLATION_TIMEOUT_MS=25000
TRANSLATION_MAX_OUTPUT_TOKENS=4096
# memory = unit tests / offline; omit to use Mongo when MONGODB_URI is configured
CONTENT_TRANSLATION_PERSISTENCE=

# Persistence overrides
# Local/dev may use memory/file. When NODE_ENV=production, durable keys default to
# mongodb and reject file|memory (see production-persistence-contract.ts).
# Ephemeral disks lose apps/api/.runtime — never rely on it in production.
NOTIFICATION_PERSISTENCE=memory
REMINDER_PERSISTENCE=memory
PUBLIC_NEWS_PERSISTENCE=mongodb
INITIATIVE_COLLECTIVE_DECISION_LIFECYCLE_DRAFT_PERSISTENCE=file
INITIATIVE_IMPLEMENTATION_COMMITMENT_LIFECYCLE_DRAFT_PERSISTENCE=file
INITIATIVE_IMPLEMENTATION_TRACKING_LIFECYCLE_DRAFT_PERSISTENCE=file
INITIATIVE_OFFICIAL_RESPONSE_LIFECYCLE_DRAFT_PERSISTENCE=file
INITIATIVE_PUBLIC_IMPACT_LIFECYCLE_DRAFT_PERSISTENCE=file
INITIATIVE_CIVIC_ARCHIVE_LIFECYCLE_DRAFT_PERSISTENCE=file
# Production: omit overrides (code defaults durable keys to mongodb) or set *=mongodb

# Public news discovery (Daily News-to-Initiative MVP)
NEWS_PROVIDER_ENABLED=true
NEWS_PROVIDER_NAME=rss
NEWS_PROVIDER_API_KEY=
NEWS_FETCH_LIMIT=30
NEWS_RETENTION_DAYS=7
NEWS_REFRESH_INTERVAL_HOURS=6

# Trusted Global Media Registry
MEDIA_REGISTRY_DEFAULT_LANGUAGE=en
MEDIA_REGISTRY_MIN_RELIABILITY=80

# Stripe Membership Contribution (TASK-092)
# Use mock provider locally unless testing real Stripe:
# MEMBERSHIP_PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MEMBERSHIP_PRICE_ID=
PLATFORM_VERSION=0.1.0

# Event infrastructure (transactional outbox)
OUTBOX_DISPATCH_ENABLED=true
OUTBOX_DISPATCH_INTERVAL_MS=2000
OUTBOX_DISPATCH_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=5
LOG_LEVEL=debug

# Official Member Badge Contribution (TASK-094) — disabled until operational/legal review
MEMBER_BADGE_CONTRIBUTIONS_ENABLED=false
MEMBER_BADGE_CONTRIBUTION_CAD_CENTS=2000
MEMBER_BADGE_PAYMENT_PROVIDER=mock
STRIPE_MEMBER_BADGE_PRICE_ID=
MEMBER_BADGE_SHIPPING_COUNTRIES=CA
STRIPE_MEMBER_BADGE_SHIPPING_RATE_CA=
STRIPE_MEMBER_BADGE_SHIPPING_RATE_US=
STRIPE_MEMBER_BADGE_SHIPPING_RATE_INTERNATIONAL=
